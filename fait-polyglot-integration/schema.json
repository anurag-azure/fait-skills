{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fait/skills/fait-polyglot-integration/schema.json",
  "title": "PSA §4(a) Polyglot System Seam & Integration Map",
  "type": "object",
  "required": ["module_or_scope", "polyglot_artifacts_present", "integration_seams", "pending_external_artifacts"],
  "properties": {
    "module_or_scope": { "type": "string" },
    "polyglot_artifacts_present": {
      "type": "object",
      "required": ["bash", "cron", "php", "mariadb"],
      "properties": {
        "bash": { "type": "integer", "minimum": 0 },
        "cron": { "type": "integer", "minimum": 0 },
        "php": { "type": "integer", "minimum": 0 },
        "mariadb": { "type": "integer", "minimum": 0 }
      }
    },
    "integration_seams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_component", "to_component", "mechanism", "data_contract", "sync_mode", "status", "evidence"],
        "properties": {
          "from_component": { "type": "string" },
          "to_component": { "type": "string" },
          "mechanism": { "type": "string", "enum": ["cron_bash", "bash_rclerk", "bash_rreport", "fp_call", "fp_chain", "fp_system", "php_sql", "fp_sql_flag", "rest_api", "sftp"] },
          "data_contract": { "type": "string" },
          "sync_mode": { "type": "string", "enum": ["synchronous", "deferred_queue", "scheduled_batch", "manual_trigger"] },
          "status": { "type": "string", "enum": ["observed_end_to_end", "partial_fp_side_only", "pending_polyglot_drop"] },
          "evidence": { "type": "array", "minItems": 1 }
        }
      }
    },
    "pending_external_artifacts": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
