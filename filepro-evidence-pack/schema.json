{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fait/skills/filepro-evidence-pack/schema.json",
  "title": "Evidence Citation & Artifact Contract",
  "type": "object",
  "required": ["artifact_path", "citations", "phi_verified_clean"],
  "properties": {
    "artifact_path": { "type": "string" },
    "phi_verified_clean": { "type": "boolean", "const": true },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "quote"],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^([A-Za-z0-9_.]+/(prc\\.[^:]+:L\\d+(-L\\d+)?|map:L\\d+|(screen|out)\\.[^\\s]+)|[A-Za-z0-9_.]+\\.\\d+|NOTE:[^\\s].*|KT@\\d{2}:\\d{2}(#frame)?|POLY:[^:]+:L\\d+(-L\\d+)?)$"
          },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    },
    "missing_dependencies": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
