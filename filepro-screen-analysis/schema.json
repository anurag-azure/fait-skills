{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fait/skills/filepro-screen-analysis/schema.json",
  "title": "filePro Screen & Operator UI Analysis",
  "type": "object",
  "required": ["table", "screens_analyzed", "operator_transitions", "interactive_events"],
  "properties": {
    "table": { "type": "string" },
    "screens_analyzed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["screen_file", "real_fields", "dummy_vars", "kt_frames", "evidence"],
        "properties": {
          "screen_file": { "type": "string" },
          "screen_title": { "type": ["string", "null"] },
          "real_fields": { "type": "array", "items": { "type": "integer" } },
          "dummy_vars": { "type": "array", "items": { "type": "string" } },
          "layout_source": { "type": "string", "enum": ["kt_frame", "strings_only", "live_walkthrough_pending"] },
          "kt_frames": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array" }
        }
      }
    },
    "operator_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from_screen", "action_or_key", "to_screen_or_table", "evidence"],
        "properties": {
          "from_screen": { "type": "string" },
          "action_or_key": { "type": "string" },
          "to_screen_or_table": { "type": "string" },
          "evidence": { "type": "array" }
        }
      }
    },
    "interactive_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trigger", "field_or_key", "behavior", "ref"],
        "properties": {
          "trigger": { "type": "string" },
          "field_or_key": { "type": "string" },
          "behavior": { "type": "string" },
          "ref": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
