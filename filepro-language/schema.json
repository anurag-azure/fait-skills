{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fait/skills/filepro-language/schema.json",
  "title": "filePro Language Interpretation Output",
  "type": "object",
  "required": ["process", "triggers", "lookups", "arrays_and_globals", "evidence"],
  "properties": {
    "process": { "type": "string", "pattern": "^[^/]+/prc\\.[^/]+$" },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "trigger_kind", "mode_scope", "line_ref"],
        "properties": {
          "label": { "type": "string" },
          "trigger_kind": { "type": "string", "enum": ["@entsel", "@key", "@wef", "@wlf", "@wbl", "@wuk", "@once", "@done", "@wbrk", "@wgt", "subroutine", "main"] },
          "mode_scope": { "type": "string", "enum": ["interactive", "batch_rz", "both", "unknown"] },
          "clears_regular_dummy_vars": { "type": "boolean" },
          "line_ref": { "type": "string" }
        }
      }
    },
    "lookups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alias", "target_table", "is_cursor_move", "flags", "line_ref"],
        "properties": {
          "alias": { "type": "string" },
          "target_table": { "type": "string" },
          "qualifier": { "type": ["string", "null"] },
          "index": { "type": ["string", "null"] },
          "is_cursor_move": { "type": "boolean" },
          "flags": { "type": "array", "items": { "type": "string" } },
          "line_ref": { "type": "string" }
        }
      }
    },
    "arrays_and_globals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "declaration_kind", "line_ref"],
        "properties": {
          "name": { "type": "string" },
          "declaration_kind": { "type": "string", "enum": ["dim_field_overlay", "dim_local", "declare_extern", "declare_global", "declare_local"] },
          "start_field": { "type": ["integer", "null"] },
          "count": { "type": ["integer", "null"] },
          "line_ref": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ref", "quote"],
        "properties": {
          "ref": { "type": "string" },
          "quote": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "additionalProperties": true
}
